{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "message",
  "description": "Fenêtres de lecture d'un message : lecture, indicateurs, déplacement, pièces jointes, invitations (et réponse, lot H1), liens (navigateur externe), « Répondre ». Écoute des événements seulement : la fenêtre principale est prévenue par le backend (notify_main).",
  "windows": [
    "message-*"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-title",
    "core:window:allow-set-focus",
    "allow-get-message",
    "allow-list-accounts",
    "allow-list-folders",
    "allow-set-seen",
    "allow-set-flagged",
    "allow-move-messages",
    "allow-move-to-role",
    "allow-open-attachment",
    "allow-save-attachment",
    "allow-show-images",
    "allow-check-signature",
    "allow-read-invitation",
    "allow-answer-invitation",
    "allow-pim-delete",
    "allow-pim-collections",
    "allow-event-save",
    "allow-open-window",
    "allow-open-url",
    "allow-window-bootstrap",
    "allow-notify-main"
  ]
}
