{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "compose",
  "description": "Fenêtres de rédaction : brouillons, envoi (signé, chiffré ou non), suggestions d'adresses. Aucun accès aux comptes ni aux sauvegardes. Écoute des événements seulement : la fenêtre principale est prévenue par le backend (notify_main).",
  "windows": [
    "compose-*"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-title",
    "core:window:allow-set-focus",
    "allow-list-accounts",
    "allow-address-suggest",
    "allow-forget-address",
    "allow-save-draft",
    "allow-discard-draft",
    "allow-open-draft",
    "allow-send-message",
    "allow-smime-signers",
    "allow-smime-missing",
    "allow-window-bootstrap",
    "allow-notify-main",
    "allow-save-draft-backup"
  ]
}
